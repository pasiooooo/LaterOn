{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.74.5",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "121",
  "optional_permissions": ["bookmarks"],
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs",
    "favicon",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["quick-switcher-modes.js", "content-preferences.js"],
    "run_at": "document_start",
    "all_frames": true
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["picker-keyboard-guard.js"],
    "run_at": "document_start"
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["keyboard-shortcuts.js"],
    "run_at": "document_start",
    "all_frames": true
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["quick-switcher-styles.js", "quick-switcher-ui.js", "quick-switcher-client.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "omnibox": {
    "keyword": "lo"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "__MSG_commandSavePage__"
    },
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "__MSG_commandSaveTabGroup__"
    },
    "save-all-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "__MSG_commandSaveSelectedTabs__"
    },
    "save-window-tabs": {
      "description": "__MSG_commandSaveAllTabs__"
    },
    "quick-switcher": {
      "suggested_key": {
        "default": "Alt+O"
      },
      "description": "__MSG_commandQuickSwitcher__"
    }
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon128.png",
        "_favicon/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
